const{chromium}=require(process.env.PLAYWRIGHT_MODULE||'playwright'),assert=require('node:assert/strict');(async()=>{const b=await chromium.launch({executablePath:'/usr/bin/google-chrome',args:['--no-sandbox']});for(const width of[320,1280])for(const reducedMotion of['no-preference','reduce'])for(const phase of['GET','POST']){const p=await b.newPage({viewport:{width,height:900},reducedMotion});await p.addInitScript(()=>{localStorage.setItem('cc_cfg_tour_v1','1');localStorage.setItem('cc_cfg_mode_v2','advanced')});let release,hold=false,snapshot;await p.route('**/api/configuration-state',async r=>{if(r.request().method()==='GET'){const res=await r.fetch(),data=await res.json();if(hold&&phase==='GET')await new Promise(done=>release=done);return r.fulfill({json:data})}snapshot=r.request().postDataJSON();if(phase==='POST')await new Promise(done=>release=done);await r.fulfill({json:{revision:'fixture-save',message:'Fixture saved. Restart to apply.'}})});await p.goto(process.env.CHATIFY_TEST_URL+'/settings.html#sec-finish');const save=p.locator('#sec-finish>.workspace-fields-save button'),field=p.locator('[data-workspace-field="storage.path"]');await save.waitFor();await field.locator('xpath=ancestor::details[1]').evaluate(n=>n.open=true);await field.fill('original-fixture.db');hold=true;await save.focus();await p.keyboard.press('Enter');await p.locator('.cc-cdlg-ok').click();while(!release)await p.waitForTimeout(10);await field.fill('newer-fixture.db');release();await p.waitForFunction(()=>!document.querySelector('#sec-finish>.workspace-fields-save button').disabled);assert.equal(snapshot.config.storage.path,'original-fixture.db');assert.equal(await field.inputValue(),'newer-fixture.db');assert(await field.evaluate(n=>n===document.activeElement));assert.match(await save.locator('..').innerText(),/Newer edits are still unsaved/);await save.locator('..').locator('p').scrollIntoViewIfNeeded();await p.screenshot({path:'/downloads/cc29-additional-newer-'+width+'-'+reducedMotion+'-'+phase+'.png'});await p.close()}await b.close();console.log('PASS additionalcapturedSaveGETPOSTnewereditskeptfocusandhonestunsaved3201280normalReduce')})().catch(e=>{console.error(e);process.exit(1)});
